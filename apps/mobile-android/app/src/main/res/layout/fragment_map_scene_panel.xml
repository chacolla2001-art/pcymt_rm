<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/background_dark"
    android:padding="16dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_rounded_dark" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/map_scene_panel_title"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/map_scene_panel_hint"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/map_scene_spatial_refs"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_spatial_refs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/map_scene_rain"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_rain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/map_scene_rain_intensity"
        android:textColor="#CCCCCC"
        android:textSize="12sp" />

    <com.google.android.material.slider.Slider
        android:id="@+id/slider_rain_intensity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="100"
        android:stepSize="1"
        android:value="45" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/map_scene_rain_size"
        android:textColor="#CCCCCC"
        android:textSize="12sp"
        android:layout_marginTop="4dp" />

    <com.google.android.material.slider.Slider
        android:id="@+id/slider_rain_size"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="8"
        android:valueTo="200"
        android:stepSize="2"
        android:value="100" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/map_scene_rain_zone"
        android:textColor="#CCCCCC"
        android:textSize="12sp"
        android:layout_marginTop="8dp" />

    <Spinner
        android:id="@+id/spinner_rain_zone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/map_scene_anim_speed"
        android:textColor="#CCCCCC"
        android:textSize="12sp"
        android:layout_marginTop="8dp" />

    <com.google.android.material.slider.Slider
        android:id="@+id/slider_anim_speed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="20"
        android:valueTo="200"
        android:stepSize="5"
        android:value="100" />

</LinearLayout>
